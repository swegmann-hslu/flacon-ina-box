{
  "name": "flacon-in-a-box",
  "displayName": "Flacon in a Box",
  "description": "Run the current folder as a tiny Flask-inspired Python teaching web application.",
  "version": "1.0.0",
  "publisher": "capystudio",
  "license": "SEE LICENSE IN LICENSE",
  "repository": {
    "type": "git",
    "url": "https://github.com/swegmann-hslu/flacon-ina-box.git"
  },
  "bugs": {
    "url": "https://github.com/swegmann-hslu/flacon-ina-box/issues"
  },
  "homepage": "https://swegmann-hslu.github.io/flacon-ina-box/",
  "qna": false,
  "pricing": "Free",
  "icon": "media/icon.png",
  "galleryBanner": {
    "color": "#063E3F",
    "theme": "dark"
  },
  "keywords": [
    "flacon",
    "flask",
    "teaching",
    "education",
    "python",
    "web"
  ],
  "engines": {
    "vscode": "^1.90.0",
    "node": ">=26.12.1 <27"
  },
  "categories": [
    "Education",
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished",
    "onCommand:flacon.start",
    "onCommand:flacon.stop",
    "onCommand:flacon.toggle",
    "onCommand:flacon.open",
    "onCommand:flacon.setupProject",
    "onCommand:flacon.fixPylancePath"
  ],
  "main": "./out/extension.js",
  "extensionKind": [
    "workspace"
  ],
  "extensionDependencies": [
    "ms-python.python"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": false,
      "description": "Flacon runs Python code from the opened workspace and therefore requires a trusted workspace."
    },
    "virtualWorkspaces": {
      "supported": false,
      "description": "Flacon requires local filesystem paths and a local Python process, which are not available in virtual workspaces."
    }
  },
  "contributes": {
    "configuration": {
      "title": "Flacon",
      "properties": {
        "flacon.ports": {
          "type": "array",
          "scope": "resource",
          "default": [
            80,
            8000,
            8080
          ],
          "items": {
            "type": "integer",
            "minimum": 1,
            "maximum": 65535
          },
          "minItems": 1,
          "uniqueItems": true,
          "description": "Ordered list of localhost ports Flacon tries when starting the Python server. Use a single value to force one port."
        }
      }
    },
    "commands": [
      {
        "command": "flacon.start",
        "title": "Flacon: Start"
      },
      {
        "command": "flacon.stop",
        "title": "Flacon: Stop"
      },
      {
        "command": "flacon.toggle",
        "title": "Flacon: Start/Stop"
      },
      {
        "command": "flacon.open",
        "title": "Flacon: Open in Browser"
      },
      {
        "command": "flacon.setupProject",
        "title": "Flacon: Setup Initial Project Structure"
      },
      {
        "command": "flacon.fixPylancePath",
        "title": "Flacon: Fix Pylance warning for 'flacon'"
      }
    ]
  },
  "scripts": {
    "sync-flacon": "node scripts/sync-flacon-resources.js",
    "compile": "npm run sync-flacon && tsc -p ./",
    "watch": "npm run sync-flacon && tsc -watch -p ./",
    "vscode:prepublish": "npm run compile"
  },
  "devDependencies": {
    "@types/node": "^26.6.2",
    "@types/vscode": "^1.138.0",
    "typescript": "^7.0.2"
  }
}
